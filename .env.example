# ---------------------------------------------------------------------------
# RankLens — environment configuration
# Copy this file to `.env` in the project root and fill in real values:
#     cp .env.example .env          (macOS / Linux)
#     Copy-Item .env.example .env   (Windows PowerShell)
# NEVER commit your real `.env` file.
#
# The dashboard pages (Overview, Level 1, Level 2) work WITHOUT any of these.
# They are only needed for the "Chatbot · AI Analysis" page and the REST API.
# ---------------------------------------------------------------------------

# PostgreSQL connection string for the chatbot. It must contain the
# public."NIRF" table. SQLAlchemy + psycopg 3 format:
#   postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Tip: use the read-only role from scripts/create_readonly_role.sql.
DATABASE_URL="postgresql+psycopg://nirf_readonly:change-me@localhost:5432/postgres"

# Sarvam AI API key, used by the `sarvam-105b` model to write SQL and answers.
# Get one at https://dashboard.sarvam.ai
SARVAM="your-sarvam-api-key"

# ---- Optional --------------------------------------------------------------

# Extra CORS origins for the FastAPI server (comma-separated).
# CHATBOT_CORS_ORIGINS="http://localhost:3000,https://my-frontend.example.com"

# Port for the FastAPI server (default 8000).
# PORT=8000

# Set to 1 to run the live-database integration tests
# (tests/chatbot_db_integration_test.py). They only run SELECT queries.
# NIRF_RUN_DB_TESTS=1
